# Next-generation synchronous domain core.  This manifest is intentionally
# independent of the legacy optional-domain source manifests.
SNNDL_NEXT_CORE_SOURCES = \
	api/TimestepTypes.h \
	events/TimestepControlEvent.h \
	snn/timestep/TimestepTracker.h \
	snn/timestep/TimestepTracker.cc \
	snn/compute/DeltaAccumulator.h \
	snn/compute/DeltaAccumulator.cc \
	snn/compute/NextGenNeuronEngine.h \
	snn/compute/NextGenNeuronEngine.cc


# Standalone v5 wire contracts.  These files are independent of SST and the
# legacy PE/workload/GAS graph; no ELI constructor is present in this target.
SNNDL_V5_CONTRACT_SOURCES = \
	v5/api/V5Types.h \
	v5/api/AddressSpace.h \
	v5/api/ArtifactContract.h \
	v5/api/ArtifactContract.cc \
	v5/api/StatisticNames.h


# P1/P2 SST-native core, provider, and request-driven local storage.  This
# manifest must remain free of legacy PE, workload, GAS, and 3D includes.
SNNDL_V5_CORE_SOURCES = \
	v5/events/CoreEvents.h \
	v5/events/StorageEvents.h \
	v5/noc/NocEventsV5.h \
	v5/noc/MulticastBranchTableV5.h \
	v5/noc/MulticastCreditV5.h \
	v5/noc/MulticastRouterV5.h \
	v5/noc/MulticastRouterV5.cc \
	v5/noc/PeEndpointV5.h \
	v5/noc/PeEndpointV5.cc \
	v5/noc/NocProbeV5.h \
	v5/noc/NocProbeV5.cc \
	v5/control/EpochCoordinatorV5.h \
	v5/control/EpochCoordinatorV5.cc \
	v5/core/LifNeuronOp.h \
	v5/core/LifNeuronOp.cc \
	v5/core/DeterministicRetireQueue.h \
	v5/core/DeterministicRetireQueue.cc \
	v5/core/CorePipeline.h \
	v5/core/CorePipeline.cc \
	v5/core/SnnCoreV5.h \
	v5/core/SnnCoreV5.cc \
	v5/storage/BankedSramV5.h \
	v5/storage/BankedSramV5.cc \
	v5/storage/SnnDmaEngineV5.h \
	v5/storage/SnnDmaEngineV5.cc \
	v5/storage/CoreStorageV5.h \
	v5/storage/CoreStorageV5.cc \
	v5/storage/BankedSramV5Component.h \
	v5/storage/BankedSramV5Component.cc \
	v5/test/IdealSynapseSource.h \
	v5/test/IdealSynapseSource.cc \
	v5/test/DmaSourceV5.h \
	v5/test/DmaSourceV5.cc \
	v5/test/SramProbeV5.h \
	v5/test/SramProbeV5.cc


# These manifests are the reviewable active-build boundary.  The former PE and
# workload graph is retained under archive/legacy_gas/ only.
EXTRA_DIST = \
	build/core_sources.am \
	build/extension_sources.am \
	build/nextgen_sources.am \
	build/v5_sources.am \
	build/v5_core_sources.am \
	tools/check_build_boundaries.py \
	tools/run_nextgen_core_tests.sh \
	archive/legacy_gas/README.md \
	docs/SNNDL_V4_STORAGE_CONTRACT.md

comp_LTLIBRARIES = \
	libSnnDLCore.la \
	libSnnDLComm.la \
	libSnnDLLocal.la \
	libSnnDLRegistry.la \
	libSnnDLResearch.la \
	libSnnDLPlatform2D.la \
	libSnnDLNextCore.la \
	libSnnDLV5Contracts.la \
	libSnnDLV5Core.la \
	libSnnDL.la

libSnnDLCore_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLComm_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLComm_la_LIBADD = libSnnDLCore.la libSnnDLRegistry.la
libSnnDLLocal_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLRegistry_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLResearch_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLResearch_la_LIBADD = libSnnDLCore.la libSnnDLComm.la libSnnDLRegistry.la

# SST-native schema-v4 2D platform.  This target owns the event graph and
# links only against the GAS-free domain core; legacy PE/workload sources are
# intentionally absent.
libSnnDLPlatform2D_la_SOURCES = \
	events/TimestepControlEvent.h \
	events/SnnMeshEvents.h \
	platform/core/SnnCoreTile.cc \
	platform/core/SnnCoreTile.h \
	components/MeshPE2D.cc \
	components/MeshPE2D.h \
	components/timestep/TimestepCoordinator.cc \
	components/timestep/TimestepCoordinator.h

libSnnDLPlatform2D_la_LDFLAGS = -module -avoid-version -L$(builddir)
libSnnDLPlatform2D_la_LIBADD = libSnnDLNextCore.la

# Pure synchronous timestep/domain contract.  It has no SST, workload, or
# research dependency and is tested independently below.
libSnnDLNextCore_la_SOURCES = $(SNNDL_NEXT_CORE_SOURCES)
libSnnDLNextCore_la_LDFLAGS = -module -avoid-version -L$(builddir)

# Header-only v5 contract types are compiled into a separate non-ELI library.
# It is intentionally not linked into the canonical v4 aggregate.
libSnnDLV5Contracts_la_SOURCES = $(SNNDL_V5_CONTRACT_SOURCES)
libSnnDLV5Contracts_la_LDFLAGS = -module -avoid-version -L$(builddir)

# P1 cycle pipeline.  The pure pipeline has no legacy dependency; the ELI
# component and ideal source are loaded through this independent library.
libSnnDLV5Core_la_SOURCES = $(SNNDL_V5_CORE_SOURCES)
libSnnDLV5Core_la_LDFLAGS = -module -avoid-version -L$(builddir)

# Aggregate compatibility name for SST installations.  The implementation is
# intentionally an empty anchor; all active ELI objects live in the libraries
# above, while no archived target is linked here.
libSnnDL_la_SOURCES = components/SnnDLCompatibility.cc
# SST loads the aggregate `libSnnDL.so` by element-library name.  Keep the
# domain libraries as DT_NEEDED entries so their ELI registration constructors
# are loaded with that entry point; otherwise the empty compatibility anchor
# hides all active components from Python configurations.
libSnnDL_la_LDFLAGS = -module -avoid-version -Wl,--no-as-needed -L$(builddir)
libSnnDL_la_LIBADD = \
	libSnnDLPlatform2D.la \
	libSnnDLV5Core.la

TEST_LINK = $(CXXLD) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) \
	$(AM_CPPFLAGS) $(CPPFLAGS) $(CXXFLAGS)

all: all-am

.SUFFIXES:
.SUFFIXES: .cc .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(srcdir)/build/core_sources.am $(srcdir)/build/extension_sources.am $(srcdir)/build/nextgen_sources.am $(srcdir)/build/v5_sources.am $(srcdir)/build/v5_core_sources.am $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign src/sst/elements/SnnDL/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign src/sst/elements/SnnDL/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(srcdir)/build/core_sources.am $(srcdir)/build/extension_sources.am $(srcdir)/build/nextgen_sources.am $(srcdir)/build/v5_sources.am $(srcdir)/build/v5_core_sources.am $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

install-compLTLIBRARIES: $(comp_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(comp_LTLIBRARIES)'; test -n "$(compdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(compdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(compdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(compdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(compdir)"; \
	}

uninstall-compLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(comp_LTLIBRARIES)'; test -n "$(compdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(compdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(compdir)/$$f"; \
	done

clean-compLTLIBRARIES:
	-test -z "$(comp_LTLIBRARIES)" || rm -f $(comp_LTLIBRARIES)
	@list='$(comp_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}
